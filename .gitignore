# Project-specific files
# Environment repos cloned by `ct settings pull` (pinned in .settings.lock.yml)
/.settings/
experiments/data/.cache_filter_jobs/
experiments/data/.cache_offline_child_tasks/
experiments/data/.cache*
# Data downloaded by experiments/scripts/release_data.py (eval logs and Scout scans) and the
# metrics / per-log extract caches the analysis builds from it. Never committed.
experiments/_logs/**/*.eval
experiments/_logs/debug/
experiments/data/scout_scans/
experiments/data/metrics_cache/
# Local DVC state (cache and credentials) from the research repository this was copied from.
/.dvc/
/.dvcignore
